# =====================================================
# SAP AI Security Anomaly Detection — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. SAP will deprecate your credentials.
# =====================================================

# --- SAP API (available April 13) ---
SAP_API_URL=https://your-sap-api-endpoint/logs
SAP_API_KEY=your_api_key_here
SAP_API_PAGE_SIZE=100

# --- SAP Alerting Webhook (available April 27) ---
SAP_WEBHOOK_URL=https://your-sap-webhook-endpoint/alert
SAP_WEBHOOK_SECRET=your_webhook_secret_here
SAP_TEAM_ID=your_team_id_here

# --- SAP HANA Database ---
HANA_HOST=your_hana_host.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=your_hana_user
HANA_PASSWORD=your_hana_password
HANA_DATABASE=your_database_name

# --- ML Model Config ---
MODEL_CONTAMINATION=0.05        # IsolationForest: expected % of anomalies
MODEL_CONTEXT_WINDOW_MINUTES=60 # How many minutes of logs to analyze at once
ANOMALY_SCORE_THRESHOLD=-0.1    # Score below this = anomaly (tune after data)

# --- App Config ---
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=30        # How often to fetch new logs from SAP API
