# =====================================================
# SAP AI Security Anomaly Detection — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. SAP will deprecate your credentials.
# =====================================================

# ─── SAP API (unlocked April 13) ─────────────────────────────────────────
# Until these are set, the fetcher runs in MOCK mode and reads
# data/samples/sample_logs.csv instead of calling the real API.
SAP_API_URL=
SAP_API_KEY=
# Note: page size is fixed server-side (BATCH_SIZE=500). Clients only paginate.

# ─── SAP Alerting (POST /alert) ──────────────────────────────────────────
# Alerts go to {SAP_API_URL}/alert with the same Bearer token as ingestion.
# The team is identified server-side from the token; SAP_TEAM_ID is kept
# only for local logs/dashboards.
SAP_TEAM_ID=TPS_DATA

# ─── SAP HANA Cloud ──────────────────────────────────────────────────────
# Until HANA_HOST is set, repositories use in-memory fallback.
HANA_HOST=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=
HANA_DATABASE=
HANA_POOL_SIZE=4

# ─── Model configuration ────────────────────────────────────────────────
MODEL_TYPE=isolation_forest            # isolation_forest | dbscan
MODEL_VERSION=latest                    # version tag or "latest"
MODEL_CONTAMINATION=0.01                # expected fraction of anomalies (recalibrated 2026-04-24)
MODEL_N_ESTIMATORS=200                  # trees in IsolationForest
MODEL_MAX_SAMPLES=auto                  # "auto" or an int (samples per tree)
MODEL_RANDOM_STATE=42                   # deterministic training seed
MODEL_CONTEXT_WINDOW_MINUTES=60         # sliding window for multi-bucket detection
ANOMALY_SCORE_THRESHOLD=0.2287          # score < threshold ⇒ flagged (p10, 2026-04-25 windowed; re-derive after retrain)

# ─── Alert thresholds (tunable post-April-13) ────────────────────────────
# Recalibrated 2026-04-24 from percentiles of the modern model's score dist.
# Re-derive via scripts/retrain_on_real_data.py after a retrain if scores shift.
ALERT_HIGH_THRESHOLD=0.0000             # score < this ⇒ "high"   (p1)
ALERT_MEDIUM_THRESHOLD=0.1210           # score < this ⇒ "medium" (p5)
ANOMALY_DEDUP_TTL_SECONDS=300           # suppress repeat alerts for this long

# ─── Latency / MTTD ──────────────────────────────────────────────────────
MTTD_HIGH_THRESHOLD_MS=5000             # dashboard turns red above this

# ─── Dashboard ───────────────────────────────────────────────────────────
DASHBOARD_REFRESH_SECONDS=5
API_BASE_URL=http://localhost:8000     # Streamlit reads metrics from here

# ─── Forensics ───────────────────────────────────────────────────────────
INCIDENT_REPORT_DIR=reports/incidents

# ─── App runtime ─────────────────────────────────────────────────────────
ENVIRONMENT=development                  # development | production
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=30                 # how often the pipeline polls
RETRAIN_EVERY_N_CYCLES=480               # retrain model every N cycles (480 × 30s = 4 hours)
